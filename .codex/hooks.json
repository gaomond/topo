{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^pipeline-impl$",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=$(git rev-parse --show-toplevel) && bash \"$repo_root/scripts/quality-gate.sh\" >&2 || exit 2",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
